<dialog class="preview-modal" id="preview-modal" aria-labelledby="preview-modal-title">
  <div class="preview-modal__chrome">
    <h2 id="preview-modal-title" class="preview-modal__title">Preview</h2>
    <div class="preview-modal__actions">
      <a class="preview-modal__external" href="#" target="_blank" rel="noopener noreferrer">Open in new tab</a>
      <button type="button" class="preview-modal__close">Close</button>
    </div>
  </div>
  <div class="preview-modal__body"></div>
</dialog>
