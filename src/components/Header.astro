---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onAbout = path === '/about';
---

<header>
  <div class="wrap nav">
    <a class="brand" href="/">
      <img src="/InfiniRiseLg.png" width="48" height="48" alt="" />
      <span class="brand-name">InfiniRise Studios<sup class="tm">&trade;</sup></span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/about" class:list={{ 'is-active': onAbout }}>About</a>
    </nav>
  </div>
</header>
