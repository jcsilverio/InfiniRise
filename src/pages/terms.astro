---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Terms of Use | InfiniRise Studios"
  description="Terms of use for infinirisestudios.com."
  canonicalPath="/terms/"
>
  <a class="skip" href="#terms">Skip to content</a>
  <Header />
  <main id="top">
    <section class="hero wrap" aria-labelledby="terms-heading">
      <div>
        <div class="kicker-wrap">
          <p class="kicker">Last updated October 13, 2026</p>
        </div>
        <h1 id="terms-heading">Terms of Use</h1>
        <p class="lede">
          These terms apply to your use of infinirisestudios.com, operated by InfiniRise Studios
          LLC. Individual products may have their own terms, which apply to those products.
        </p>
      </div>
    </section>

    <section id="terms" class="policy">
      <div class="wrap">
        <h2>Use of this site</h2>
        <p>
          You may browse this site for personal or business information. Do not misuse it,
          interfere with its operation, or attempt to access it by automated means that place an
          unreasonable load on it.
        </p>

        <h2>Content</h2>
        <p>
          The text, images, logos, and other content on this site belong to InfiniRise Studios LLC
          or its licensors. InfiniRise Studios is a trademark of InfiniRise Studios LLC. Credits
          listed on the About page refer to work by the named individual at the studios and
          companies named, and are the property of their respective owners.
        </p>

        <h2>Information only</h2>
        <p>
          Content on this site is general information, provided as is, without warranties of any
          kind. It is not legal, financial, or professional advice.
        </p>

        <h2>Links to other sites</h2>
        <p>
          This site may link to sites we do not control. We are not responsible for their content
          or practices.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the extent permitted by law, InfiniRise Studios LLC is not liable for any indirect or
          consequential loss arising from your use of this site.
        </p>

        <h2>Privacy</h2>
        <p>See the <a href="/privacy">privacy page</a> for how visitor information is handled.</p>

        <h2>Changes and governing law</h2>
        <p>
          We may update these terms; the date above shows the latest version. These terms are
          governed by the laws of the State of Georgia, United States.
        </p>

        <h2>Contact</h2>
        <p>
          <a href="mailto:contact@infinirisestudios.com">contact@infinirisestudios.com</a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initSiteMotion } from '../scripts/site.ts';

  initSiteMotion();
</script>
