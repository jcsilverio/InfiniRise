---
interface Props {
  title?: string;
  description?: string;
  ogImagePath?: string;
  canonicalPath?: string;
  extraJsonLd?: Record<string, unknown>;
}

const {
  title = 'InfiniRise Studios',
  description = 'InfiniRise Studios builds software products and web tools. Atlanta, Georgia.',
  ogImagePath = '/InfiniRiseLg.png',
  canonicalPath = '/',
  extraJsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://infinirisestudios.com');
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL(ogImagePath, site).href;
const logo = new URL('/InfiniRiseLg.png', site).href;
const linkedIn = 'https://www.linkedin.com/in/joellesilverio/';
const huggingFace = 'https://huggingface.co/jcsilv';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'InfiniRise Studios LLC',
  url: new URL('/', site).href,
  description: 'InfiniRise Studios builds software products and web tools.',
  logo,
  founder: {
    '@type': 'Person',
    name: 'Joelle Silverio',
    jobTitle: 'Founder',
    sameAs: [linkedIn, huggingFace],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18509379690"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18509379690');
    </script>
    <script is:inline>
      // .reveal content stays visible unless the reveal script initializes within 2s.
      document.documentElement.classList.add('js-reveal');
      setTimeout(function () {
        var root = document.documentElement;
        if (!root.classList.contains('reveal-ready')) root.classList.remove('js-reveal');
      }, 2000);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b132b" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/InfiniRiseLg.png" type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
    )}
    <script defer data-domain="infinirisestudios.com" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
